{
  "name": "pratibimb",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pin:generate": "node scripts/generate-ort-pin.mjs",
    "pin:check": "node scripts/generate-ort-pin.mjs --check",
    "demo": "node tests/browser/demo/run-sih-demo.mjs",
    "demo:present": "node tests/browser/demo/run-sih-demo.mjs --present",
    "reasoner": "node scripts/reasoner/reasoner.mjs",
    "reasoner:check": "node scripts/reasoner/reasoner.mjs --check",
    "reasoner:stop": "node scripts/reasoner/reasoner.mjs --stop",
    "test": "vitest run",
    "typecheck": "tsc -b --force && tsc -p apps/extension/tsconfig.json",
    "verify": "python scripts/verify-repo.py && npm run pin:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
